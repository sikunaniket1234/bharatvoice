# Copy to .env for local development; never commit .env or real credentials.

# Gateway
AI_SERVICE_URL=http://127.0.0.1:8000
PORT=3000
API_HOST=127.0.0.1
WEB_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------------------------------------------------------------------------
# AI inference
# ---------------------------------------------------------------------------
# Set AI_INSTALL_ML=true to build the AI container with PyTorch, Transformers
# and IndicTransToolkit. Left false, the service starts and reports not-ready.
AI_INSTALL_ML=false

# auto resolves to cuda when torch.cuda.is_available(), otherwise cpu.
AI_DEVICE=auto
AI_DTYPE=float16

# IndicTrans2 distilled 200M checkpoints. Both are gated on Hugging Face: accept
# the repository conditions with your account before downloading.
AI_TRANSLATION_MODEL_EN_INDIC=ai4bharat/indictrans2-en-indic-dist-200M
AI_TRANSLATION_MODEL_INDIC_EN=ai4bharat/indictrans2-indic-en-dist-200M

# Preload a checkpoint at startup instead of paying a cold start on the first
# request. Useful for benchmarks, less useful for an idle development machine.
AI_EAGER_LOAD=false

# false releases VRAM after each request. Keep true for interactive latency,
# set false when sharing the GPU with other models on a 4 GB card.
AI_KEEP_MODEL_RESIDENT=true

# Supply a Hugging Face read token to download the gated checkpoints.
# Never commit a real token.
# HF_TOKEN=